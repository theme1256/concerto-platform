{
  "name": "campsych/concerto-platform",
  "license": "Apache-2.0",
  "type": "project",
  "description": "Online adaptive testing platform",
  "autoload": {
    "psr-4": {
      "": "src/"
    },
    "classmap": [
      "app/AppKernel.php",
      "app/AppCache.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.4",
    "cocur/slugify": "^4.7",
    "doctrine/dbal": "^4.5",
    "doctrine/doctrine-bundle": "^2.19",
    "doctrine/inflector": "^2.0",
    "doctrine/orm": "^3.7",
    "doctrine/persistence": "^4.0",
    "incenteev/composer-parameter-handler": "^2.0",
    "league/oauth2-server-bundle": "^0.8",
    "lexik/jwt-authentication-bundle": "^3.2",
    "onelogin/php-saml": "^4.3",
    "scheb/2fa-bundle": "^7.14",
    "scheb/2fa-google-authenticator": "^7.14",
    "symfony/asset": "7.4.*",
    "symfony/config": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dependency-injection": "7.4.*",
    "symfony/doctrine-bridge": "7.4.*",
    "symfony/error-handler": "7.4.*",
    "symfony/event-dispatcher": "7.4.*",
    "symfony/expression-language": "7.4.*",
    "symfony/filesystem": "7.4.*",
    "symfony/finder": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-foundation": "7.4.*",
    "symfony/http-kernel": "7.4.*",
    "symfony/monolog-bundle": "^3.7",
    "symfony/password-hasher": "7.4.*",
    "symfony/polyfill-apcu": "^1.0",
    "symfony/polyfill-php86": "^1.43",
    "symfony/process": "7.4.*",
    "symfony/routing": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-core": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/security-http": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/twig-bridge": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/yaml": "7.4.*",
    "twig/twig": "^3.27"
  },
  "require-dev": {
    "masterminds/html5": "^2.9",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/debug-bundle": "7.4.*",
    "symfony/dom-crawler": "7.4.*",
    "symfony/phpunit-bridge": "^7.4",
    "symfony/stopwatch": "7.4.*",
    "symfony/var-dumper": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*"
  },
  "conflict": {
    "symfony/clock": ">=8.0",
    "symfony/property-info": ">=8.0",
    "symfony/string": ">=8.0",
    "symfony/type-info": ">=8.0",
    "symfony/var-exporter": ">=8.0"
  },
  "scripts": {
    "symfony-scripts": [
      "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
      "@php bin/console cache:clear --no-warmup",
      "@php bin/console assets:install web --symlink --relative"
    ],
    "post-install-cmd": [
      "@symfony-scripts"
    ],
    "post-update-cmd": [
      "@symfony-scripts"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    },
    "platform": {
      "php": "8.5.12"
    }
  },
  "extra": {
    "incenteev-parameters": [
      {
        "file": "app/config/parameters_test_runner.yml"
      },
      {
        "file": "app/config/parameters_uio.yml"
      },
      {
        "file": "app/config/parameters_administration.yml"
      },
      {
        "file": "app/config/parameters.yml"
      },
      {
        "file": "app/config/parameters_saml.yml"
      }
    ],
    "branch-alias": {
      "dev-master": "3.4-dev"
    }
  }
}
