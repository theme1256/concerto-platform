{
  "name": "campsych/concerto-platform",
  "license": "Apache-2.0",
  "type": "project",
  "description": "Online adaptive testing platform",
  "autoload": {
    "psr-4": {
      "": "src/"
    },
    "classmap": [
      "app/AppKernel.php",
      "app/AppCache.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "files": [
      "vendor/symfony/symfony/src/Symfony/Component/VarDumper/Resources/functions/dump.php"
    ]
  },
  "require": {
    "php": ">=8.4",
    "cocur/slugify": "^4.7",
    "doctrine/dbal": "^4.5",
    "doctrine/doctrine-bundle": "^2.19",
    "doctrine/inflector": "^2.0",
    "doctrine/orm": "^3.7",
    "doctrine/persistence": "^4.0",
    "incenteev/composer-parameter-handler": "^2.0",
    "league/oauth2-server-bundle": "^0.8",
    "lexik/jwt-authentication-bundle": "^3.2",
    "onelogin/php-saml": "^4.3",
    "scheb/2fa-bundle": "^7.14",
    "scheb/2fa-google-authenticator": "^7.14",
    "symfony/doctrine-messenger": "6.4.*",
    "symfony/monolog-bundle": "^3.7",
    "symfony/polyfill-apcu": "^1.0",
    "symfony/polyfill-php86": "^1.43",
    "symfony/symfony": "6.4.*",
    "twig/twig": "^3.27"
  },
  "require-dev": {
    "masterminds/html5": "^2.9",
    "symfony/phpunit-bridge": "^6.4"
  },
  "scripts": {
    "symfony-scripts": [
      "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
      "@php bin/console cache:clear --no-warmup",
      "@php bin/console assets:install web --symlink --relative"
    ],
    "post-install-cmd": [
      "@symfony-scripts"
    ],
    "post-update-cmd": [
      "@symfony-scripts"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    },
    "platform": {
      "php": "8.5.12"
    }
  },
  "extra": {
    "incenteev-parameters": [
      {
        "file": "app/config/parameters_test_runner.yml"
      },
      {
        "file": "app/config/parameters_uio.yml"
      },
      {
        "file": "app/config/parameters_administration.yml"
      },
      {
        "file": "app/config/parameters.yml"
      },
      {
        "file": "app/config/parameters_saml.yml"
      }
    ],
    "branch-alias": {
      "dev-master": "3.4-dev"
    }
  }
}
