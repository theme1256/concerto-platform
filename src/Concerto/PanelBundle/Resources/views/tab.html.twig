{% extends "base_include.html.twig" %}
{% trans_default_domain "panel" %}

{% block content %}
    <div class="moduleList" ng-if="tabSection == 'list'">
        {{ include("@ConcertoPanel/list.html.twig", {'class_name':class_name}) }}
    </div>

    <div class="moduleForm" ng-if="tabSection == 'form'">
        {{ render(controller("Concerto\\PanelBundle\\Controller\\" ~ class_name ~ "Controller::formAction")) }}
    </div>
{% endblock %}